			items = <
				["at0000"] = <
					text = <"Range of motion of a joint">
					description = <"Measurement of the extent of motion for a specified simple or complex movement around an indentified joint or section of the spine.">
				>
				["at0000.1"] = <
					text = <"Qualitative range of motion of a joint">
					description = <"Clinical estimate of the extent of a specified movement around an identified joint or section of the spine, graded qualitatively, with any pain elicited by the movement.">
				>
