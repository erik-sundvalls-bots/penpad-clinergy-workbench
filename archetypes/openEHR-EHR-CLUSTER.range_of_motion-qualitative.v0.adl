archetype (adl_version=1.4; uid=18adf8a5-d9a0-4be8-9dbb-f7c7db70a087)
	openEHR-EHR-CLUSTER.range_of_motion-qualitative.v0
specialize
	openEHR-EHR-CLUSTER.range_of_motion.v1

concept
	[at0000.1]	-- Qualitative range of motion of a joint
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
				["name"] = <"PEN&PAD workbench draft translation, not yet reviewed by a Swedish clinician">
			>
		>
	>

description
	original_author = <
		["name"] = <"PEN&PAD workbench (draft prepared for Erik Sundvall)">
		["organisation"] = <"erik-sundvalls-bots (PEN&PAD workbench)">
		["date"] = <"2026-11-18">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record a qualitative, bedside estimate of the range of a specified movement around a joint, and any pain the movement elicits.">
			use = <"Use where the range of motion is graded qualitatively (full, reduced, limited, minimal or fixed) rather than measured, and where pain on the tested movement is recorded as part of the same finding. All elements of the parent archetype CLUSTER.range_of_motion.v1 remain available, including the measured 'Range of motion' and 'Clinical interpretation'. Designed for the 'Examination findings' SLOT in CLUSTER.exam.v2 and its specialisations. This specialisation exists as an interim solution until the qualitative range and pain on movement are added to CLUSTER.range_of_motion itself.">
			keywords = <"range of motion", "ROM", "joint", "movement", "pain on movement", "qualitative", "full range", "reduced range">
			misuse = <"Not to be used for a goniometric measurement alone - use CLUSTER.range_of_motion.v1. Not to be used for pain reported in the history - use CLUSTER.symptom_sign within OBSERVATION.story. Not to be used for tenderness on palpation.">
			copyright = <"© openEHR Foundation (parent archetype); © 2026 Erik Sundvall / erik-sundvalls-bots (specialisation)">
		>
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"Att registrera en kvalitativ, klinisk uppskattning av omfånget för en angiven rörelse kring en led, och eventuell smärta som rörelsen framkallar.">
			use = <"Används där rörelseomfånget graderas kvalitativt (full, nedsatt, begränsad, minimal eller fixerad) i stället för att mätas, och där smärta vid den undersökta rörelsen registreras som en del av samma fynd. Alla element i föräldraarketypen CLUSTER.range_of_motion.v1 finns kvar, inklusive uppmätt 'Rörelseomfång' och 'Klinisk tolkning'. Avsedd för SLOT:en 'Undersökningsfynd' i CLUSTER.exam.v2 och dess specialiseringar. Specialiseringen är en tillfällig lösning tills kvalitativt rörelseomfång och smärta vid rörelse finns i CLUSTER.range_of_motion.">
			keywords = <"rörelseomfång", "rörlighet", "led", "rörelse", "smärta vid rörelse", "kvalitativ">
			misuse = <"Används inte enbart för goniometermätning - använd CLUSTER.range_of_motion.v1. Används inte för smärta som rapporteras i anamnesen - använd CLUSTER.symptom_sign i OBSERVATION.story. Används inte för palpationsömhet.">
			copyright = <"© openEHR Foundation (parent archetype); © 2026 Erik Sundvall / erik-sundvalls-bots (specialisation)">
		>
	>
	lifecycle_state = <"in_development">
	other_contributors = <"Drafted with the openEHR Assistant tooling; clinical review pending", ...>
	other_details = <
		["references"] = <"Derived from: Range of motion of a joint, published archetype [Internet]. openEHR Foundation, openEHR Clinical Knowledge Manager, revision 1.0.2. Available from: https://ckm.openehr.org/ckm/archetypes/1013.1.7057">
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/. Derived from CLUSTER.range_of_motion.v1 (© openEHR Foundation, CC BY-SA 4.0).">
		["custodian_organisation"] = <"erik-sundvalls-bots (local draft, not CKM-governed)">
		["original_namespace"] = <"local">
		["original_publisher"] = <"erik-sundvalls-bots">
		["revision"] = <"0.0.1-alpha">
		["build_uid"] = <"9cb91630-395b-4bd5-a503-df02bfa017ff">
		["ip_acknowledgement"] = <"This artefact includes content from SNOMED Clinical Terms (SNOMED CT), which is copyrighted material of SNOMED International. Implementers need an appropriate SNOMED CT Affiliate licence.">
		["snomed_ct_verification"] = <"SNOMED CT International Edition 20260701 (tx.fhir.org $lookup, checked 2026-11-18). 'No pain' is unbound.">
	>

definition
	CLUSTER[at0000.1] occurrences matches {1..*} matches {    -- Qualitative range of motion of a joint
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0002] matches {    -- Movement
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0003,    -- Abduction
							at0004,    -- Adduction
							at0005,    -- Extension
							at0006,    -- Flexion
							at0007,    -- Internal rotation
							at0008,    -- External rotation
							at0009,    -- Inversion
							at0010,    -- Eversion
							at0011,    -- Medial rotation
							at0012,    -- Lateral rotation
							at0013,    -- Dorsiflexion
							at0014,    -- Plantar flexion
							at0015,    -- Ulnar deviation
							at0016,    -- Radial deviation
							at0017,    -- Pronation
							at0018,    -- Supination
							at0019,    -- Reposition
							at0020,    -- Opposition
							at0021,    -- Radial abduction
							at0022,    -- Palmar abduction
							at0030,    -- Right lateral flexion
							at0031,    -- Left lateral flexion
							at0032,    -- Right rotation
							at0033,    -- Left rotation
							at0042,    -- Retraction
							at0043,    -- Protraction
							at0044,    -- Upward rotation
							at0045,    -- Downward rotation
							at0046,    -- Elavation
							at0047,    -- Depression
							at0048,    -- Opening
							at0049,    -- Closing
							at0050,    -- Rightward jaw translation
							at0051,    -- Leftward jaw translation
							at0052,    -- Protrusion
							at0053]    -- Retrusion
						}
					}
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0023] occurrences matches {0..1} matches {    -- Starting position
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0024] occurrences matches {0..1} matches {    -- Mode of examination
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0025,    -- Active
							at0034,    -- Active-assisted
							at0026]    -- Passive
						}
					}
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0027] occurrences matches {0..1} matches {    -- Range of motion
				value matches {
					C_DV_QUANTITY <
						
						list = <
							["1"] = <
								units = <"deg">
								magnitude = <|-360.0..360.0|>
							>
							["2"] = <
								units = <"mm">
							>
							["3"] = <
								units = <"cm">
							>
						>
					>
				}
			}
			ELEMENT[at0.1] occurrences matches {0..1} matches {    -- Qualitative range
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0.2,    -- Full
							at0.3,    -- Reduced
							at0.4,    -- Limited
							at0.5,    -- Minimal
							at0.6]    -- Fixed
						}
					}
				}
			}
			ELEMENT[at0.7] occurrences matches {0..1} matches {    -- Pain on movement
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0.8,    -- No pain
							at0.9,    -- Mild pain
							at0.10,    -- Moderate pain
							at0.11]    -- Severe pain
						}
					}
				}
			}
			ELEMENT[at0035] occurrences matches {0..1} matches {    -- Clinical interpretation
				value matches {
					DV_TEXT matches {*}
				}
			}
			allow_archetype CLUSTER[at0028] occurrences matches {0..*} matches {    -- Additional details
				include
					archetype_id/value matches {/.*/}
			}
			ELEMENT[at0029] occurrences matches {0..1} matches {    -- Comment
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

