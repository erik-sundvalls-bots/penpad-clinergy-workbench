				["at0.1"] = <
					text = <"Qualitative range">
					description = <"Qualitative grade of the extent of the movement compared with the expected normal range.">
					comment = <"Use when the range is estimated at the bedside rather than measured. If measured, record the value in 'Range of motion'.">
				>
				["at0.2"] = <
					text = <"Full">
					description = <"The movement reaches the expected normal range.">
				>
				["at0.3"] = <
					text = <"Reduced">
					description = <"The movement is somewhat less than the expected normal range.">
				>
				["at0.4"] = <
					text = <"Limited">
					description = <"The movement is markedly less than the expected normal range.">
				>
				["at0.5"] = <
					text = <"Minimal">
					description = <"Only a trace of movement is possible.">
				>
				["at0.6"] = <
					text = <"Fixed">
					description = <"No movement is possible; the joint is fixed.">
				>
				["at0.7"] = <
					text = <"Pain on movement">
					description = <"Pain elicited by the tested movement, and its intensity.">
					comment = <"Record 'No pain' to state explicitly that the movement was not painful.">
				>
				["at0.8"] = <
					text = <"No pain">
					description = <"The movement did not elicit pain.">
				>
				["at0.9"] = <
					text = <"Mild pain">
					description = <"The movement elicited mild pain.">
				>
				["at0.10"] = <
					text = <"Moderate pain">
					description = <"The movement elicited moderate pain.">
				>
				["at0.11"] = <
					text = <"Severe pain">
					description = <"The movement elicited severe pain.">
				>
			>
		>
