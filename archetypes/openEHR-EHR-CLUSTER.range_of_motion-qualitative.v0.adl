				["at0.1"] = <
					text = <"Kvalitativt rörelseomfång">
					description = <"Kvalitativ gradering av rörelsens omfång jämfört med förväntat normalt omfång.">
					comment = <"Används när omfånget uppskattas kliniskt i stället för att mätas. Om det mäts registreras värdet i 'Rörelseomfång'.">
				>
				["at0.2"] = <
					text = <"Full">
					description = <"Rörelsen når förväntat normalt omfång.">
				>
				["at0.3"] = <
					text = <"Nedsatt">
					description = <"Rörelsen är något mindre än förväntat normalt omfång.">
				>
				["at0.4"] = <
					text = <"Begränsad">
					description = <"Rörelsen är påtagligt mindre än förväntat normalt omfång.">
				>
				["at0.5"] = <
					text = <"Minimal">
					description = <"Endast en antydan till rörelse är möjlig.">
				>
				["at0.6"] = <
					text = <"Fixerad">
					description = <"Ingen rörelse är möjlig; leden är fixerad.">
				>
				["at0.7"] = <
					text = <"Smärta vid rörelse">
					description = <"Smärta som framkallas av den undersökta rörelsen, och dess intensitet.">
