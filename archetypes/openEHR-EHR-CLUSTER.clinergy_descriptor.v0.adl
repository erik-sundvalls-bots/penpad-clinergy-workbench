archetype (adl_version=1.4; uid=7c1a0b2e-4e55-4b1a-9c3d-6f0a1b2c3d4e)
	openEHR-EHR-CLUSTER.clinergy_descriptor.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["name"] = <"PEN&PAD Clinergy workbench">
		["organisation"] = <"erik-sundvalls-bots">
		["date"] = <"2026-11-16">
	>
	lifecycle_state = <"unmanaged">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"Local extension for Clinergy descriptors that have no element in the published symptom/sign, problem qualifier, or range-of-motion archetypes.">
			use = <"Nest in CLUSTER.symptom_sign specific-details or CLUSTER.range_of_motion additional-details. Not for publication as a CKM archetype until the change requests in docs/ckm-change-requests.md are decided.">
			copyright = <"© 2026 the workbench authors. Clinergy value names remain © 1997-8 Semantic Technologies Ltd / Victoria University of Manchester.">
		>
	>
	other_details = <
		["licence"] = <"Apache-2.0 for this local archetype text.">
		["revision"] = <"0.0.1">
	>

definition
	CLUSTER[at0000] matches {    -- Clinergy descriptor
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Frequency
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Consistency
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- Texture
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- Pain on movement
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0005] occurrences matches {0..1} matches {    -- Duration unit
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Clinergy descriptor">
					description = <"Qualifiers from the 1998 Clinergy thumb form that published archetypes do not yet enumerate.">
				>
				["at0001"] = <
					text = <"Frequency">
					description = <"Infrequent, occasional or frequent. symptom_sign and problem_qualifier have no such scale.">
				>
				["at0002"] = <
					text = <"Consistency">
					description = <"Soft, firm, hard or fluctuant swelling.">
				>
				["at0003"] = <
					text = <"Texture">
					description = <"Rough, smooth, nodular or irregular swelling.">
				>
				["at0004"] = <
					text = <"Pain on movement">
					description = <"Pain felt during a tested thumb movement.">
				>
				["at0005"] = <
					text = <"Duration unit">
					description = <"The unit of a duration whose magnitude is stored as DV_DURATION on the symptom.">
				>
			>
		>
	>
