<?xml version="1.0" encoding="UTF-8"?>
<!--
  thumb-pain-encounter.v2 operational skeleton.
  Not a CKM template export. Node ids and at-codes match templates/thumb-pain.webtemplate.json.
  Published archetypes and revisions are listed in docs/ckm-change-requests.md.
  ehrtslib 0.12 webTemplateToOpt() builds the in-memory OPERATIONAL_TEMPLATE from that web template;
  the minified runtime used in the page does not export an XML serializer.
-->
<template xmlns="http://schemas.openehr.org/v1">
  <template_id><value>thumb-pain-encounter.v2</value></template_id>
  <COMPOSITION id="thumb-pain-encounter.v2" name="Encounter" node_id="openEHR-EHR-COMPOSITION.encounter.v1">
    <DV_CODED_TEXT id="category" name="Category" node_id="at0000">
    </DV_CODED_TEXT>
    <EVENT_CONTEXT id="context" name="Context">
      <DV_DATE_TIME id="start_time" name="Start time">
      </DV_DATE_TIME>
      <DV_CODED_TEXT id="setting" name="Setting" node_id="at0000">
      </DV_CODED_TEXT>
    </EVENT_CONTEXT>
    <PARTY_IDENTIFIED id="composer" name="Composer">
    </PARTY_IDENTIFIED>
    <SECTION id="history" name="History" node_id="openEHR-EHR-SECTION.adhoc.v1">
      <OBSERVATION id="story" name="Story/History" node_id="openEHR-EHR-OBSERVATION.story.v1">
        <EVENT id="any_event" name="Any event" node_id="at0002">
          <DV_TEXT id="story_text" name="Story" node_id="at0004">
          </DV_TEXT>
          <CLUSTER id="symptom" name="Symptom/Sign" node_id="openEHR-EHR-CLUSTER.symptom_sign.v2">
            <DV_CODED_TEXT id="name" name="Symptom/Sign name" node_id="at0001">
            </DV_CODED_TEXT>
            <CLUSTER id="body_site" name="Anatomical location" node_id="openEHR-EHR-CLUSTER.anatomical_location.v1">
              <DV_CODED_TEXT id="site_name" name="Body site name" node_id="at0001">
              </DV_CODED_TEXT>
              <DV_CODED_TEXT id="specific_site" name="Specific site" node_id="at0065">
              </DV_CODED_TEXT>
              <DV_CODED_TEXT id="laterality" name="Laterality" node_id="at0002">
              </DV_CODED_TEXT>
            </CLUSTER>
            <DV_CODED_TEXT id="onset" name="Onset timing" node_id="at0164">
            </DV_CODED_TEXT>
            <DV_DURATION id="duration" name="Episode duration" node_id="at0028">
            </DV_DURATION>
            <DV_CODED_TEXT id="severity" name="Severity category" node_id="at0021">
            </DV_CODED_TEXT>
            <DV_CODED_TEXT id="character" name="Character" node_id="at0189">
            </DV_CODED_TEXT>
            <DV_CODED_TEXT id="progression" name="Progression" node_id="at0180">
            </DV_CODED_TEXT>
            <DV_CODED_TEXT id="pattern" name="Pattern" node_id="at0003">
            </DV_CODED_TEXT>
            <CLUSTER id="descriptor" name="Clinergy descriptor" node_id="openEHR-EHR-CLUSTER.clinergy_descriptor.v0">
              <DV_CODED_TEXT id="frequency" name="Frequency" node_id="at0001">
              </DV_CODED_TEXT>
              <DV_CODED_TEXT id="consistency" name="Consistency" node_id="at0002">
              </DV_CODED_TEXT>
              <DV_CODED_TEXT id="texture" name="Texture" node_id="at0003">
              </DV_CODED_TEXT>
              <DV_CODED_TEXT id="duration_unit" name="Duration unit" node_id="at0005">
              </DV_CODED_TEXT>
            </CLUSTER>
          </CLUSTER>
        </EVENT>
      </OBSERVATION>
      <OBSERVATION id="screening" name="Symptom/sign screening" node_id="openEHR-EHR-OBSERVATION.symptom_sign_screening.v1">
        <EVENT id="any_event" name="Any event" node_id="at0002">
          <CLUSTER id="screened" name="Specific symptom/sign" node_id="at0022">
            <DV_CODED_TEXT id="name" name="Symptom/sign name" node_id="at0004">
            </DV_CODED_TEXT>
            <DV_CODED_TEXT id="presence" name="Presence" node_id="at0005">
            </DV_CODED_TEXT>
          </CLUSTER>
        </EVENT>
      </OBSERVATION>
    </SECTION>
    <SECTION id="examination" name="Examination" node_id="openEHR-EHR-SECTION.adhoc.v1">
      <OBSERVATION id="exam" name="Physical examination" node_id="openEHR-EHR-OBSERVATION.exam.v1">
        <EVENT id="any_event" name="Any event" node_id="at0002">
          <CLUSTER id="detail" name="Examination findings" node_id="openEHR-EHR-CLUSTER.exam.v2">
            <DV_CODED_TEXT id="structure" name="System or structure examined" node_id="at0001">
            </DV_CODED_TEXT>
            <CLUSTER id="body_site" name="Anatomical location" node_id="openEHR-EHR-CLUSTER.anatomical_location.v1">
              <DV_CODED_TEXT id="site_name" name="Body site name" node_id="at0001">
              </DV_CODED_TEXT>
              <DV_CODED_TEXT id="specific_site" name="Specific site" node_id="at0065">
              </DV_CODED_TEXT>
              <DV_CODED_TEXT id="laterality" name="Laterality" node_id="at0002">
              </DV_CODED_TEXT>
            </CLUSTER>
            <DV_CODED_TEXT id="interpretation" name="Clinical interpretation" node_id="at0006">
            </DV_CODED_TEXT>
            <CLUSTER id="tenderness" name="Tenderness" node_id="openEHR-EHR-CLUSTER.symptom_sign.v2">
              <DV_CODED_TEXT id="name" name="Symptom/Sign name" node_id="at0001">
              </DV_CODED_TEXT>
            </CLUSTER>
            <CLUSTER id="movement" name="Range of motion" node_id="openEHR-EHR-CLUSTER.range_of_motion.v1">
              <DV_CODED_TEXT id="movement" name="Movement" node_id="at0002">
              </DV_CODED_TEXT>
              <DV_CODED_TEXT id="interpretation" name="Clinical interpretation" node_id="at0035">
              </DV_CODED_TEXT>
              <CLUSTER id="descriptor" name="Pain on movement" node_id="openEHR-EHR-CLUSTER.clinergy_descriptor.v0">
                <DV_CODED_TEXT id="pain_on_movement" name="Pain on movement" node_id="at0004">
                </DV_CODED_TEXT>
              </CLUSTER>
            </CLUSTER>
            <CLUSTER id="not_done" name="Exclusion of examination" node_id="openEHR-EHR-CLUSTER.exclusion_exam.v1">
              <DV_BOOLEAN id="flag" name="Examination not done" node_id="at0001">
              </DV_BOOLEAN>
            </CLUSTER>
          </CLUSTER>
        </EVENT>
      </OBSERVATION>
      <OBSERVATION id="screening" name="Absent tenderness" node_id="openEHR-EHR-OBSERVATION.symptom_sign_screening.v1">
        <EVENT id="any_event" name="Any event" node_id="at0002">
          <CLUSTER id="screened" name="Specific symptom/sign" node_id="at0022">
            <DV_CODED_TEXT id="name" name="Symptom/sign name" node_id="at0004">
            </DV_CODED_TEXT>
            <DV_CODED_TEXT id="presence" name="Presence" node_id="at0005">
            </DV_CODED_TEXT>
          </CLUSTER>
        </EVENT>
      </OBSERVATION>
    </SECTION>
    <SECTION id="assessment" name="Assessment" node_id="openEHR-EHR-SECTION.adhoc.v1">
      <EVALUATION id="problem" name="Problem/Diagnosis" node_id="openEHR-EHR-EVALUATION.problem_diagnosis.v1">
        <DV_CODED_TEXT id="name" name="Problem/Diagnosis name" node_id="at0002">
        </DV_CODED_TEXT>
        <CLUSTER id="body_site" name="Anatomical location" node_id="openEHR-EHR-CLUSTER.anatomical_location.v1">
          <DV_CODED_TEXT id="site_name" name="Body site name" node_id="at0001">
          </DV_CODED_TEXT>
          <DV_CODED_TEXT id="specific_site" name="Specific site" node_id="at0065">
          </DV_CODED_TEXT>
          <DV_CODED_TEXT id="laterality" name="Laterality" node_id="at0002">
          </DV_CODED_TEXT>
        </CLUSTER>
        <DV_CODED_TEXT id="certainty" name="Diagnostic certainty" node_id="at0073">
        </DV_CODED_TEXT>
      </EVALUATION>
      <EVALUATION id="exclusion" name="Exclusion - specific" node_id="openEHR-EHR-EVALUATION.exclusion_specific.v1">
        <DV_CODED_TEXT id="concept" name="Excluded concept" node_id="at0003">
        </DV_CODED_TEXT>
      </EVALUATION>
    </SECTION>
  </COMPOSITION>
</template>
